# Server connection. Both values are required when configured.
MUMAIN_SERVER_IP=127.0.0.1
MUMAIN_SERVER_PORT=44405

# Runtime diagnostics. Accepted values: 1/0, true/false, on/off.
MU_NETWORK_DIAGNOSTICS=0
MU_RENDER_TIMING=0

# Optional frame capture. Uncomment both values to capture one PPM frame.
# MU_CAPTURE_FRAME=120
# MU_CAPTURE_PATH=/tmp/mu-frame.ppm
